# Google OAuth Configuration
# Get these values from https://console.developers.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/callback

# Server Configuration
PORT=8080

# Database Configuration
# When set, the server uses Google Cloud Datastore instead of the local SQLite
# file and can read secrets from Secret Manager
# GOOGLE_CLOUD_PROJECT=your_project_id_here

# Stripe Configuration (for subscriptions)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_ID=price_your_price_id_here

# Subscription Feature Flag
SUBSCRIPTION_ENABLED=true

# Admin Configuration
# ADMIN_TOKEN is read by the admin CLI (cmd/admin, admin.sh) and must be a token
# stored in the database. Create one with:
#   ADMIN_TOKEN="bootstrap" ./admin.sh create-token "description"
# A server outside App Engine also compares its own ADMIN_TOKEN, which may be any
# string, with the X-Admin-Token header on cron and task requests.
ADMIN_TOKEN=your_64_character_admin_token_here
# Comma-separated emails granted admin access
INITIAL_ADMIN_EMAILS=your-email@example.com

# CSRF Configuration
# Generate with: openssl rand -base64 32
# REQUIRED in production (GAE_ENV=standard or ENVIRONMENT=production)
# Application will fail to start in production if not set
# In development, a random secret is auto-generated (tokens won't survive restarts)
# CSRF_SECRET=base64_encoded_32_byte_secret_here

# Set to "production" for production behavior outside App Engine:
# Secure cookies, production cookie names, and a mandatory CSRF_SECRET
# ENVIRONMENT=production

# Security Configuration
# HMAC key for deleted-account tombstones. Generate with: openssl rand -base64 32
# Without it, account deletion writes no tombstone. Do not rotate it.
# ACCOUNT_TOMBSTONE_KEY=base64_encoded_key_here
# The single origin allowed to make cross-origin API requests (default: none)
# ALLOWED_ORIGIN=https://other-origin.example.com
# Send the Content Security Policy in report-only mode (default: false)
# CSP_REPORT_ONLY=true

# Session Configuration
# In-memory session cache duration, as a Go duration (default: 10m)
# SESSION_CACHE_TTL=10m

# Feed Fetching
# Per-domain limit on feed fetches (defaults: 120 per minute, burst of 30)
# RATE_LIMIT_REQUESTS_PER_MINUTE=120
# RATE_LIMIT_BURST_SIZE=30
# Feed refresh scheduling, as Go durations (defaults shown).
# SCHEDULER_MIN_INTERVAL must not exceed SCHEDULER_UPDATE_WINDOW.
# SCHEDULER_UPDATE_WINDOW=15m
# SCHEDULER_MIN_INTERVAL=5m
# SCHEDULER_MAX_CONCURRENT=10
# SCHEDULER_CLEANUP_INTERVAL=1h

# App Engine Deployment (set in app.yaml, not needed locally)
# OAuth callback URL for the fixed staging version
# STAGING_REDIRECT_URL=https://staging-dot-your-project.uc.r.appspot.com/auth/callback
# Secret Manager names for the OAuth credentials (defaults shown)
# SECRET_CLIENT_ID_NAME=google-client-id
# SECRET_CLIENT_SECRET_NAME=google-client-secret
# Cloud Tasks queue for cron work (defaults shown)
# CLOUD_TASKS_QUEUE=cron-tasks
# CLOUD_TASKS_LOCATION=us-central1

# Configuration Validation
# Makes `make validate-config` treat missing OAuth credentials and a missing
# GOOGLE_CLOUD_PROJECT as errors
# VALIDATE_STRICT=true

# Note: For local development, make sure to:
# 1. Create a Google OAuth application at https://console.developers.google.com/
# 2. Add http://localhost:8080/auth/callback to authorized redirect URIs
# 3. Create a Stripe account at https://stripe.com/ (optional, for subscriptions)
# 4. Copy this file to .env and fill in your actual values
# 5. Install dependencies: go mod tidy